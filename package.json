{
  "name": "solarlandroid",
  "version": "0.1.0",
  "description": "FNF Mod Manager for mobile! Easily mod your FNF instances with one app.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
