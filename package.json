    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "~2.5.1",
    "@tauri-apps/plugin-upload": "~2.5.0",
    "beercss": "^5.0.3",
    "material-dynamic-colors": "^1.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
